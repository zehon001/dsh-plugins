{
  "name": "dsh-agent-bridge",
  "version": "0.2.0",
  "description": "DSH plugin: workspace & session orchestration for in-app agents and external tools — REST API, SSE event stream, webhooks, completion notifications to parent sessions, and model-facing orchestrator tools.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/core.js && node --check lib/http.js && node --check lib/catalog.js && node --check lib/tools.js && node --check lib/util.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "orchestration",
    "workspace",
    "session",
    "sse",
    "webhook",
    "api"
  ],
  "exports": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zehon001/dsh-plugins.git",
    "directory": "plugins/dsh-agent-bridge"
  }
}
